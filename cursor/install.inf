[Version]
signature="$CHICAGO$"

[DefaultInstall]
CopyFiles = Scheme.Cur
AddReg = Scheme.Reg

[DestinationDirs]
Scheme.Cur = 25,Cursors

[Scheme.Cur]
Alternate.cur
EWResize_1.cur
Help.cur
Link.cur
Move.cur
NEResize_1.cur
Normal.cur
NotAllowed.cur
NSResize_1.cur
NWResize_1.cur
Precision.cur
Text.cur
AppStarting.ani
Wait.ani

[Scheme.Reg]
HKCU,"Control Panel\Cursors","UpArrow",,"%25%\Cursors\Alternate.cur"
HKCU,"Control Panel\Cursors","SizeWE",,"%25%\Cursors\EWResize_1.cur"
HKCU,"Control Panel\Cursors","Help",,"%25%\Cursors\Help.cur"
HKCU,"Control Panel\Cursors","Hand",,"%25%\Cursors\Link.cur"
HKCU,"Control Panel\Cursors","SizeAll",,"%25%\Cursors\Move.cur"
HKCU,"Control Panel\Cursors","SizeNESW",,"%25%\Cursors\NEResize_1.cur"
HKCU,"Control Panel\Cursors","Arrow",,"%25%\Cursors\Normal.cur"
HKCU,"Control Panel\Cursors","No",,"%25%\Cursors\NotAllowed.cur"
HKCU,"Control Panel\Cursors","SizeNS",,"%25%\Cursors\NSResize_1.cur"
HKCU,"Control Panel\Cursors","SizeNWSE",,"%25%\Cursors\NWResize_1.cur"
HKCU,"Control Panel\Cursors","Cross",,"%25%\Cursors\Precision.cur"
HKCU,"Control Panel\Cursors","IBeam",,"%25%\Cursors\Text.cur"
HKCU,"Control Panel\Cursors","AppStarting",,"%25%\Cursors\AppStarting.ani"
HKCU,"Control Panel\Cursors","Wait",,"%25%\Cursors\Wait.ani"
; Set scheme name
HKCU,"Control Panel\Cursors","(Default)",,"Cartoonish Set"
HKCU,"Control Panel\Cursors\Schemes","Cartoonish Set",,""